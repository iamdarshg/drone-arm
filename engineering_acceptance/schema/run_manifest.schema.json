{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance run manifest",
  "type": "object",
  "required": [
    "run_id",
    "timestamp_utc",
    "profile",
    "drone_arm_sha",
    "drone_mech_sha",
    "test_definition_sha256",
    "config_path",
    "config_sha256",
    "tool_version",
    "python_version",
    "results"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "string"
    },
    "drone_arm_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "drone_mech_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "test_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_path": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_version": {
      "type": "string"
    },
    "python_version": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "artifact_sha256",
          "check_exit_code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "check_exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
