{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "kind": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/quantity"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "path"
      ],
      "properties": {
        "repo": {
          "enum": [
            "drone-arm",
            "drone-mech"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "provenance",
        "evidence_id"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "integer",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "1",
            "m",
            "mm",
            "kg",
            "g",
            "s",
            "A",
            "V",
            "W",
            "Wh",
            "J",
            "K",
            "C",
            "degC",
            "rad",
            "deg",
            "Hz",
            "rpm",
            "m2",
            "mm2",
            "kg*m2",
            "Pa",
            "USD",
            "kg/m3",
            "Ah",
            "ohm"
          ]
        },
        "provenance": {
          "enum": [
            "measured",
            "sourced",
            "modeled",
            "assumed",
            "unknown"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "enum": [
                  "measured",
                  "sourced"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              },
              "evidence_id": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "interface": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "signal",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "1",
            "m",
            "mm",
            "kg",
            "g",
            "s",
            "A",
            "V",
            "W",
            "Wh",
            "J",
            "K",
            "C",
            "degC",
            "rad",
            "deg",
            "Hz",
            "rpm",
            "m2",
            "mm2",
            "kg*m2",
            "Pa",
            "USD",
            "kg/m3",
            "Ah",
            "ohm"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "title": "Typed engineering component",
  "required": [
    "id",
    "kind",
    "source",
    "properties"
  ],
  "additionalProperties": false
}
