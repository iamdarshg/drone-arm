{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "status",
    "source",
    "artifact",
    "sha256",
    "unit",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "path"
      ],
      "properties": {
        "repo": {
          "enum": [
            "drone-arm",
            "drone-mech"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "enum": [
        "measured",
        "sourced",
        "modeled",
        "assumed",
        "unknown"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
