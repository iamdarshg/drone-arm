{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "status",
    "source",
    "artifact",
    "sha256",
    "unit",
    "provenance",
    "timestamp_utc",
    "command",
    "runner",
    "tool_versions",
    "measured",
    "required",
    "tolerance",
    "exit_code",
    "source_signature"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "path"
      ],
      "properties": {
        "repo": {
          "enum": [
            "drone-arm",
            "drone-mech"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "1",
        "m",
        "mm",
        "kg",
        "g",
        "s",
        "A",
        "V",
        "W",
        "Wh",
        "J",
        "K",
        "C",
        "degC",
        "rad",
        "deg",
        "Hz",
        "rpm",
        "m2",
        "mm2",
        "kg*m2",
        "Pa",
        "USD",
        "kg/m3",
        "Ah",
        "ohm",
        null
      ]
    },
    "provenance": {
      "enum": [
        "measured",
        "sourced",
        "modeled",
        "assumed",
        "unknown"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "string"
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "measured": {},
    "required": {},
    "tolerance": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_signature": {
      "type": "string",
      "minLength": 1
    },
    "raw_receipt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "raw_receipt"
        ],
        "properties": {
          "raw_receipt": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
