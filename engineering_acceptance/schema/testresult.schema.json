{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance ledger result row",
  "type": "object",
  "required": [
    "id",
    "status",
    "run_id",
    "timestamp_utc",
    "drone_arm_sha",
    "drone_mech_sha",
    "test_definition_sha256",
    "exact_command",
    "command",
    "runner",
    "check_exit_code",
    "source",
    "source_revision",
    "artifact_paths",
    "artifact_sha256",
    "artifacts",
    "evidence_required",
    "profile",
    "system",
    "variant",
    "severity",
    "applicability",
    "blocking",
    "unit",
    "required",
    "measured",
    "errors",
    "config_path",
    "config_sha256",
    "tool_version",
    "python_version",
    "tool_versions",
    "config_present"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "drone_arm_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "drone_mech_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "test_definition_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "exact_command": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "runner": {
      "type": [
        "string",
        "object"
      ]
    },
    "check_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "issue",
        "url",
        "revision"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_required": {
      "type": "boolean"
    },
    "profile": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "variant": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicability": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "blocking": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "1",
        "m",
        "mm",
        "kg",
        "g",
        "s",
        "A",
        "V",
        "W",
        "Wh",
        "J",
        "K",
        "C",
        "degC",
        "rad",
        "deg",
        "Hz",
        "rpm",
        "m2",
        "mm2",
        "kg*m2",
        "Pa",
        "USD",
        "kg/m3",
        "Ah",
        "ohm",
        null
      ]
    },
    "required": {},
    "measured": {},
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config_path": {
      "type": "string"
    },
    "config_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_version": {
      "type": "string"
    },
    "python_version": {
      "type": "string"
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "previous_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_manifest_path": {
      "type": "string"
    },
    "run_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_present": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          },
          "evidence_required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_present": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "config_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_present": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        }
      }
    }
  ]
}
